---
import oldLocationImage from '../assets/images/old-location.webp'
---

<div class="container">
  <div class="title-container">
    <span class="reveal reveal-grow"></span><h2 class="section-title reveal reveal-right">Our Story</h2>
  </div>
  <div class="about-grid">
    <img class="reveal reveal-up" src={oldLocationImage.src} alt="">
    <div class="about-text reveal reveal-up">
      <h3>A history of excellence.</h3>
      <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Eius ab corporis perspiciatis natus, eos officiis ratione amet aliquid voluptatem omnis asperiores nulla quidem iure autem!</p>
      <a class="cta-btn" href="#">Read Our Story</a>
    </div>
  </div>
</div>

<style>
.section-title {
  color: white;
}

.about-grid {
  display: grid;
  gap: 50px;
  grid-template-columns: 1fr 1fr;
}

.about-grid img {
  place-self: center;
  width: 70%;
  height: auto;
}

.about-text {
  padding: 15px;
  place-self: center;
  color: white;
  border-left: 2px solid var(--primary-blue);
  border-bottom: 2px solid var(--primary-blue);
}

.about-text h3 {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.about-text p {
  font-weight: 500;
}

@media (max-width: 768px) {
  .about-grid {
    grid-template-columns: 1fr;
  }
  .about-grid img {
    width: 60%;
  }
}

@media (max-width: 480px) {
  .about-grid img {
    width: 80%;
  }
}
</style>
