---
import BaseLayout from '../layouts/BaseLayout.astro'
import logo from '../assets/images/demo-logo.png'
import oldLocationImage from '../assets/images/old-location.webp'
import tpoImage from '../assets/images/service-tpo.webp'
import epdmImage from '../assets/images/service-tpdm.webp'
import bitumenImage from '../assets/images/service-bitumen.webp'
const pageTitle = "Commercial and Industrial Roofing | Riverside Roofing"
---
<BaseLayout pageTitle={pageTitle}>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <img src={logo.src} alt="">
        <div class="hero-title">
          <h1>A roofing legacy that stands the test of time.</h1>
          <p>For over 70 years, we have been the trusted source of high-quality flat top, industrial, commercial and specialty residential roofing.</p>
          <a href="tel:+17052740375">Give us a Call</a>
        </div>
      </div>
    </div>
    <div class="hero-bg"></div>
  </section>
  <section class="services" id="services">
    <div class="container">
      <h2 class="section-title">Our Services</h2>
      <div class="services-grid">
        <div class="service-card">
          <img src={tpoImage.src} alt="" class="card-img">
          <div class="card-body">
            <h3>TPO Roofing</h3>
            <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Accusantium dolorum possimus atque, inventore itaque maiores nisi id quae voluptatem amet aut eligendi vitae similique dicta?</p>
          </div>
        </div>
        <div class="service-card">
          <img src={epdmImage.src} alt="" class="card-img">
          <div class="card-body">
            <h3>EPDM Roofing</h3>
            <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Accusantium dolorum possimus atque, inventore itaque maiores nisi id quae voluptatem amet aut eligendi vitae similique dicta?</p>
            <a href="#">More About EPDM</a>
          </div>
        </div>
        <div class="service-card">
          <img src={bitumenImage.src} alt="" class="card-img">
          <div class="card-body">
            <h3>2-Ply Bitumen Roofing</h3>
            <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Accusantium dolorum possimus atque, inventore itaque maiores nisi id quae voluptatem amet aut eligendi vitae similique dicta?</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="about-section" id="about">
    <div class="container">
      <h2 class="section-title">Our Story</h2>
      <div class="about-grid">
        <img src={oldLocationImage.src} alt="">
        <div class="about-text">
          <h3>A history of excellence.</h3>
          <p>Lorem ipsum, dolor sit amet consectetur adipisicing elit. Minima iusto ullam optio sed ab, cumque magni. Fuga molestiae ex error autem voluptate. Laboriosam illo in voluptates, esse voluptas maxime ipsam, molestiae sunt facere facilis nostrum adipisci harum est neque odio tempore earum ratione necessitatibus repellendus cupiditate. Nemo necessitatibus ad atque!</p>
          <a href="#">Read Our Story</a>
        </div>
      </div>
    </div>
    <div class="about-bg"></div>
  </section>
</BaseLayout>

<style>
section {
  padding: 100px 0;
}

.section-title {
  font-size: 2rem;
  margin-bottom: 100px;
}

.section-title::before {
  content: '';
  padding: 2px;
  width: 50px;
  background: var(--primary-red);
  border-radius: 10px;
}
/*Hero Elements*/
.hero {
  position: relative;
  background: rgba(255, 255, 255, 0.3);
}

.hero-grid {
  text-shadow: 1px 1px 2px gray;
  display: grid;
  grid-template-columns: 1fr;
}

.hero-grid img {
  width: clamp(40%, 400px, 90%);
  height: auto;
  place-self: center;
}

.hero-title {
  place-self: center;
  width: clamp(30%, 400px, 90%);
  text-align: center;
}

.hero-title h1 {
  font-size: 2rem;
  margin-bottom: 10px;
}

a {
  display: inline-block;
  padding: 0.8rem 2rem;
  background-color: var(--primary-red);
  margin-top: 15px;
  text-decoration: none;
  font-weight: 600;
  color: white;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.3s ease;
  box-shadow: 1px 2px 5px gray;
  border-radius: 5px;
}

a:hover {
  transform: translateY(-2px);
  background: rgb( from var(--primary-red) r g b /0.8);
  border: 2px solid (--primary-red);
  
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  background-image: url('/tpo-roof.jpg');
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* Services Section */

.services {
  background: #F0F0F0;
}

.services-grid {
  gap: 30px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
}

.service-card {
  background: white;
  box-shadow: 3px 3px 15px rgba(128, 128, 128, 0.1);
}

.service-card h3 {
  margin-bottom: 10px;
}

/* Service Cards */

.card-img {
  width: 100%;
  height: auto;
  object-fit: cover;
  object-position: center;
}

/* About Us Section */
.about-section {
  position: relative;
  background-color: rgba(111, 143, 175, 1);
}

.about-section .section-title {
  color: white;
}

.about-grid {
  display: grid;
  gap: 50px;
  grid-template-columns: 1fr 1fr;
}

.about-grid img {
  place-self: center;
  width: 70%;
  height: auto;
}

.about-text {
  padding: 15px;
  place-self: center;
  color: white;
  border-left: 2px solid var(--primary-blue);
  border-bottom: 2px solid var(--primary-blue);
}

.about-text h3 {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.about-text p {
  font-size: 1.25rem;
}

.card-body {
  padding: 15px;
}

@media (max-width: 768px) {
  .services-grid {
    grid-template-columns: 1fr 1fr;
  }
  .about-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 480px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
}
</style>
