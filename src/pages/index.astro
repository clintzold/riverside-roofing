---
import BaseLayout from '../layouts/BaseLayout.astro'
import Services from '../components/Services.astro'
import WorkGallery from '../components/WorkGallery.astro'
import AboutPreview from '../components/AboutPreview.astro'
import Contact from '../components/Contact.astro'
import logo from '../assets/images/demo-logo.png'
const pageTitle = "Commercial and Industrial Roofing | Riverside Roofing"
---
<BaseLayout pageTitle={pageTitle}>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <img src={logo.src} alt="">
        <div class="hero-title">
          <h1>A roofing legacy that stands the test of time.</h1>
          <p>Windsor, Ontario's trusted source for high-quality flat top, industrial, commercial and specialty residential roofing for over 70 years.</p>
          <a class="cta-btn" href="tel:+17052740375">Give us a Call</a>
        </div>
      </div>
    </div>
    <div class="hero-bg"></div>
  </section>
  <section class="services" id="services">
    <Services />
  </section>
  <section class="about-section" id="about">
    <AboutPreview />
  </section>
  <section class="gallery">
    <WorkGallery />
  </section>
  <section class="contact-section" id="contact">
    <Contact />
  </section>
</BaseLayout>

<style>
/*Hero Elements*/
.hero {
  position: relative;
  background: rgba(255, 255, 255, 0.3);
  padding: 150px 0;
}

.hero-grid {
  text-shadow: 1px 1px 2px gray;
  display: grid;
  grid-template-columns: 1fr;
}

.hero-grid img {
  width: clamp(30%, 300px, 90%);
  height: auto;
  place-self: center;
}

.hero-title {
  place-self: center;
  width: clamp(30%, 450px, 95%);
  text-align: center;
}

.hero-title h1 {
  font-size: 2.25rem;
  margin-bottom: 10px;
}

.hero-title p {
  font-size: 1.25rem;
  font-family: 'Roboto';
}


.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  background-image: url('/tpo-roof.jpg');
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
  width: 100%;
  height: 100%;
  z-index: -1;
}


/* About Us Section */
.about-section {
  background-color: var(--light-blue);
}

.contact-section {
  background: var(--light-blue);
}

</style>
