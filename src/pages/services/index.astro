---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Contact from '../../components/Contact.astro'
import Commercial from '../../components/Commercial.astro'
import Emergency from '../../components/service-components/Emergency.astro'
import logo from '../../assets/images/demo-logo_preview.png'
---
<BaseLayout pageTitle="Comprehensive Commercial Roofing Services">
  <section id="overview" class="overview-section">
    <div class="container">
      <div class="grid-2">
        <div class="text-card">
          <h1>Expert Commercial and Flat Top Roofing Services in Windsor, Ontario</h1>
          <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Fugiat et odio, eius obcaecati dolore architecto? Debitis magni dolor similique deserunt. Quam rem veritatis ducimus enim aperiam. Totam obcaecati quibusdam distinctio.</p>
          <h2>Services We Provide:</h2>
          <ul>
            <li><a href="#">Commercial Roofing</a></li>
            <li><a href="#">Roof Replacement</a></li>
            <li><a href="#">Emergency Repairs</a></li>
            <li><a href="#">Roof Maintenace</a></li>
          </ul>
        </div>
        <img class="logo" src={logo.src} alt="">
      </div>
      <div class="flex justify-center">
        <div class="text-card text-center cta-card">
          <p>Not sure what you're looking for or just need some advice? Give us a call and we'd be happy to chat.</p>
          <a href="#" class="cta-btn">Give Us A Call</a>
        </div>
      </div>
    </div>
  </section>
  <section id="commercial-roofing" class="commercial-roofing-section">
    <Commercial/>
  </section>
  <section id="roof-replacement" class="roof-replacement-section">
    <div class="container">
      <div class="title-container">
        <span class="reveal reveal-grow"></span><h2 class="section-title reveal reveal-right">Roof Replacement</h2>
      </div>
      <div class="grid-2">
        <div class="text-card">
          <h3>Heading 3</h3>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
        </div>
      </div>
    </div>
  </section>
  <section id="emergency-repairs" class="emergency-repairs-section">
    <Emergency/>
  </section>
  <section id="roof-assessments" class="roof-assessments-section">
    <div class="container">
      <div class="title-container">
        <span class="reveal reveal-grow"></span><h2 class="section-title reveal reveal-right">Maintenance</h2>
      </div>
      <div class="grid-2">
        <div class="text-card">
          <h3>Stop A Leak Before It Starts</h3>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
          <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Laboriosam quia, dignissimos veniam sapiente nam, vitae numquam mollitia quaerat nobis eum enim, nemo optio recusandae ratione?</p>
        </div>
        <div class="service-response-card">
        </div>
      </div>
    </div>
  </section>
  <section id="contact-us" class="contact-section">
    <Contact/>
  </section>
</BaseLayout>

<style>
.overview-section {
  background: var(--primary-gray);
}

.flex {
  padding-top: 50px;
}

.roof-replacement-section {
}

.contact-section {
  background: var(--light-blue);
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.grid-3 {
  padding: 0 1rem;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1rem;
}

.materials-grid {
  padding-bottom: 5rem;
}

ul {
  padding-left: 3rem;
  list-style-type: none;
}

li a {
  padding: 1rem 0 1rem 2rem;
  background-color: var(--primary-red);
  color: white;
  display: inline-block;
  width: clamp(10%, 250px, 80%);
  text-decoration: none;
  font-family: 'Roboto';
  font-weight: bold;
}

li {
  margin-bottom: 0.5rem;
}


.text-card {
  padding: 1rem;
}
.text-card h1, .text-card p, .text-card h2 {
  margin-bottom: 1rem;
}

.text-card h3, .card-body h3 {
  margin-bottom: 0.5rem;
}

.cta-card {
  width: clamp(25%, 450px, 80%);
  background: var(--light-blue);
  border: 4px solid var(--primary-blue);
  border-radius: 15px;
  margin-top: 5rem;
  font-weight: 500;
}

.logo {
  width: 80%;
  place-self: center;
}

@media (max-width: 480px) {
  .grid-2, .grid-3 {
    grid-template-columns: 1fr;
  }
  .logo {
    grid-row: 1;
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: 1.5rem;
  }

  .flex {
    padding-top: 10px;
  }

  ul {
    display: flex;
    flex-direction: column;
  }
}
</style>
